---
interface Props {
  text?: string;
  tag?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'p' | 'span' | 'div';
  className?: string;
  delay?: number;
  duration?: number;
  splitType?: 'chars' | 'words';
  textAlign?: string;
}

const {
  text = '',
  tag = 'p',
  className = '',
  delay = 30,
  duration = 0.8,
  splitType = 'chars',
  textAlign = 'left'
} = Astro.props;

const Tag = tag;

// Split into words first to preserve natural mobile word wrapping
const words = text.split(' ');
let globalCharIndex = 0;
---

<Tag
  class={`split-text-wrapper ${className}`}
  style={`text-align: ${textAlign}; display: inline; word-break: break-word; overflow-wrap: break-word;`}
  data-delay={delay}
  data-duration={duration}
>
  {words.map((word, wIdx) => {
    const chars = Array.from(word);
    return (
      <span class="split-word" style="display: inline-block; white-space: nowrap;">
        {chars.map((char) => {
          return (
            <span
              class="split-token"
              style={`display: inline-block; opacity: 0; transform: translateY(35px); transition: opacity ${duration}s cubic-bezier(0.215, 0.61, 0.355, 1), transform ${duration}s cubic-bezier(0.215, 0.61, 0.355, 1);`}
            >
              {char}
            </span>
          );
        })}
        {wIdx < words.length - 1 && <span class="split-space">&nbsp;</span>}
      </span>
    );
  })}
</Tag>

<script>
  function initSplitText() {
    const wrappers = document.querySelectorAll('.split-text-wrapper');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const wrapper = entry.target as HTMLElement;
          const delayMs = parseInt(wrapper.getAttribute('data-delay') || '30', 10);
          const tokens = wrapper.querySelectorAll('.split-token');
          
          tokens.forEach((token, index) => {
            setTimeout(() => {
              (token as HTMLElement).style.opacity = '1';
              (token as HTMLElement).style.transform = 'translateY(0)';
            }, index * delayMs);
          });

          observer.unobserve(wrapper);
        }
      });
    }, { threshold: 0.1 });

    wrappers.forEach((el) => observer.observe(el));
  }

  initSplitText();
  document.addEventListener('astro:page-load', initSplitText);
</script>
