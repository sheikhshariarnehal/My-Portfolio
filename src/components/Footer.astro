---
import type { SocialLink } from '../lib/helpers';

export interface Props {
  isSubPage?: boolean;
  socialLinks?: SocialLink[];
}

const { isSubPage = false, socialLinks = [] } = Astro.props;

const quickLinks = [
  { href: isSubPage ? '/#home' : '#home', label: 'home' },
  { href: isSubPage ? '/#about' : '#about', label: 'about' },
  { href: isSubPage ? '/#skills' : '#skills', label: 'skills' },
  { href: isSubPage ? '/#education' : '#education', label: 'education' },
  { href: '/projects', label: 'projects' },
  { href: '/experience', label: 'experience' },
];
---

<footer class="footer">
  <div class="box-container">
    <div class="box">
      <h3>Shariar Portfolio</h3>
      <p>
        Thank you for visiting my personal portfolio website. Connect with me over social media or direct inquiry.
      </p>
      <div class="tagline">
        Keep Rising 🚀. Feel free to drop a message!
      </div>
    </div>

    <div class="box">
      <h3>Quick Links</h3>
      {quickLinks.map((link) => (
        <a href={link.href}>
          <i class="fas fa-chevron-right"></i> {link.label}
        </a>
      ))}
    </div>

    <div class="box">
      <h3>Contact Info</h3>
      <p><i class="fas fa-phone"></i> +880 1750-627421</p>
      <p><i class="fas fa-envelope"></i> nehal22205101260@diu.edu.bd</p>
      <p><i class="fas fa-map-marker-alt"></i> Nowabgonj, Dhaka, Bangladesh</p>
      <div class="share">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            class={link.className}
            aria-label={link.label}
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class={link.icon}></i>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="credit">
    Designed with <i class="fa fa-heart pulse"></i> by
    <a href="https://www.linkedin.com/in/sheikh-shariar-nehal-473166268/" target="_blank" rel="noopener noreferrer">Sheikh Shariar Nehal</a>
  </div>
</footer>
